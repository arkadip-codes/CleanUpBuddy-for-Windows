<Window x:Class="CleanupBuddy.CleaningOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#000000"
        AllowsTransparency="False"
        ResizeMode="NoResize">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- CLEANING MODE ACTIVE label -->
            <TextBlock Text="CLEANING MODE ACTIVE"
                       Foreground="#888888"
                       FontSize="11"
                       FontWeight="Normal"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Live timer -->
            <TextBlock x:Name="TimerLabel"
                       Text="00:00"
                       Foreground="#FFFFFF"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI"
                       Margin="0,0,0,12"/>

            <!-- Thin separator line -->
            <Rectangle Width="32" Height="1" Fill="#2A2A2A" HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- SVG-style progress ring (Canvas) -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,12">
                <!-- Background circle -->
                <Ellipse Width="72" Height="72"
                         Stroke="#2E2E2E" StrokeThickness="3.5"
                         Fill="Transparent"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Progress arc drawn via code -->
                <Canvas Width="96" Height="96" x:Name="RingCanvas">
                    <Path x:Name="RingPath"
                          Stroke="#0067C0"
                          StrokeThickness="3.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>

                <!-- Keyboard emoji inside ring -->
                <TextBlock Text="⌨️" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Hold instruction -->
            <TextBlock x:Name="HoldLabel"
                       Text="Hold both Alt keys to unlock"
                       Foreground="#CCCCCC"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <!-- Key chips -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Border Background="#1C1C1C" BorderBrush="#3D3D3D" BorderThickness="1"
                        CornerRadius="5" Padding="10,5" Margin="0,0,4,0">
                    <TextBlock Text="L Alt" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="+" Foreground="#666666" FontSize="14" VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <Border Background="#1C1C1C" BorderBrush="#3D3D3D" BorderThickness="1"
                        CornerRadius="5" Padding="10,5" Margin="0,0,6,0">
                    <TextBlock Text="R Alt" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="·" Foreground="#666666" FontSize="14" VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock Text="3s" Foreground="#666666" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Status pill -->
            <Border Background="#141414" BorderBrush="#2D2D2D" BorderThickness="1"
                    CornerRadius="20" Padding="14,6" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusPill" Foreground="#777777" FontSize="11"/>
            </Border>

        </StackPanel>
    </Grid>
</Window>
