<Window x:Class="CleanupBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup Buddy"
        Width="340" Height="430"
        MinWidth="340" MinHeight="430"
        MaxWidth="340" MaxHeight="430"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource InterLight}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Toggle button style -->
        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource ToggleOffBrush}"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row card style -->
        <Style x:Key="CardRow" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource RowBgBrush}"/>
            <Setter Property="BorderBrush"  Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="14,10"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
        </Style>

        <!-- Start button style -->
        <Style x:Key="StartBtn" TargetType="Button">
            <Setter Property="Background"    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="FontWeight"    Value="Bold"/>
            <Setter Property="FontSize"      Value="14"/>
            <Setter Property="Height"        Value="44"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS dot button: coloured circle, icon fades in on individual hover -->
        <Style x:Key="MacDotBtn" TargetType="Button">
            <Setter Property="Width"            Value="13"/>
            <Setter Property="Height"           Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="13" Height="13">
                            <!-- Coloured dot -->
                            <Ellipse x:Name="Circle"
                                     Fill="{TemplateBinding Background}"
                                     Width="13" Height="13"/>
                            <!-- Icon — hidden by default, shown on mouse-over -->
                            <TextBlock x:Name="Icon"
                                       Text="{TemplateBinding Tag}"
                                       FontSize="8"
                                       FontWeight="Black"
                                       FontFamily="Segoe UI"
                                       Foreground="#D9000000"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0.5,0,0"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon"   Property="Opacity" Value="1"/>
                                <Setter TargetName="Circle" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Appearance card style -->
        <Style x:Key="AppearanceCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource RowBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="12,10"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- Outer border: shadow + border only, no clipping -->
    <Border CornerRadius="12"
            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" BlurRadius="18" Opacity="0.18" Color="Black"/>
        </Border.Effect>

        <!-- Inner border: background + corner radius. Clip applied in code-behind -->
        <Border x:Name="RootClipBorder" CornerRadius="12"
                Background="{DynamicResource CardBrush}"
                SizeChanged="RootClipBorder_SizeChanged"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="WindowScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>   <!-- title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Appearance button — left, uses gear.png -->
                    <Button Grid.Column="0"
                            x:Name="AppearanceBtn"
                            Margin="12,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}"
                            Cursor="Hand" VerticalAlignment="Center"
                            Click="AppearanceBtn_Click"
                            ToolTip="Appearance">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="3">
                                    <Image Source="pack://application:,,,/Assets/gear.png"
                                           Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- App name — centred, with PNG icon instead of broom emoji -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/titlebar-icon.png"
                               Width="22" Height="22" Margin="0,0,6,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="Cleanup Buddy"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- macOS traffic lights — right: [minimize] [close] -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                        <!-- Yellow = Minimise (left of close) -->
                        <Button Style="{StaticResource MacDotBtn}"
                                Background="#FEBC2E"
                                Tag="–"
                                Margin="0,0,8,0"
                                Click="MinimizeBtn_Click"/>
                        <!-- Red = Close (rightmost) -->
                        <Button Style="{StaticResource MacDotBtn}"
                                Background="#FF5F57"
                                Tag="✕"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Content area ── -->
            <Grid Grid.Row="1">

                <!-- ══ HOME VIEW ══ -->
                <Grid x:Name="HomeView" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Keyboard -->
                    <Border Grid.Row="0" Style="{StaticResource CardRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- keyboard.png -->
                                <Image Source="pack://application:,,,/Assets/keyboard.png"
                                       Width="26" Height="26" Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel>
                                    <TextBlock Text="Keyboard" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Block all key presses" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="KeyboardToggle"
                                          Style="{StaticResource ToggleStyle}"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Row 2: Mouse -->
                    <Border Grid.Row="1" Style="{StaticResource CardRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- left-click.png -->
                                <Image Source="pack://application:,,,/Assets/left-click.png"
                                       Width="26" Height="26" Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel>
                                    <TextBlock Text="Mouse" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="Block clicks &amp; scroll" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" x:Name="MouseToggle"
                                          Style="{StaticResource ToggleStyle}"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Row 3: Brightness -->
                    <Border Grid.Row="2" Style="{StaticResource CardRow}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- contrast.png -->
                                    <Image Source="pack://application:,,,/Assets/contrast.png"
                                           Width="26" Height="26" Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel>
                                        <TextBlock Text="Boost Brightness" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Spot every smudge clearly" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="BrightnessLabel"
                                           Text="100%" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Slider -->
                            <Slider x:Name="BrightnessSlider"
                                    Minimum="0" Maximum="100" Value="100"
                                    Margin="0,10,0,4"
                                    ValueChanged="BrightnessSlider_ValueChanged">
                                <Slider.Template>
                                    <ControlTemplate TargetType="Slider">
                                        <Grid x:Name="SliderGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Track x:Name="PART_Track" Grid.Row="1">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton x:Name="FillPart" Height="4" BorderThickness="0"
                                                                  Background="{DynamicResource AccentBrush}"
                                                                  Command="Slider.DecreaseLarge">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="2,0,0,2"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Height="4" BorderThickness="0"
                                                                  Background="{DynamicResource BorderBrush2}"
                                                                  Command="Slider.IncreaseLarge">
                                                        <RepeatButton.Template>
                                                            <ControlTemplate TargetType="RepeatButton">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="0,2,2,0"/>
                                                            </ControlTemplate>
                                                        </RepeatButton.Template>
                                                    </RepeatButton>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Ellipse Fill="White"
                                                                         Stroke="{DynamicResource AccentBrush}"
                                                                         StrokeThickness="2">
                                                                    <Ellipse.Effect>
                                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                                                                          Opacity="0.3" Color="Black"/>
                                                                    </Ellipse.Effect>
                                                                </Ellipse>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Slider.Template>
                            </Slider>

                            <Grid Margin="2,0">
                                <TextBlock Text="Off" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="Max" FontSize="10"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Start Cleaning button -->
                    <Button Grid.Row="4" x:Name="StartBtn"
                            Style="{StaticResource StartBtn}"
                            Content="Start Cleaning"
                            Click="StartBtn_Click">
                        <Button.ToolTip>
                            <ToolTip x:Name="StartBtnTip"
                                     Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1"
                                     Padding="10,7" HasDropShadow="True">
                                <TextBlock Text="Please choose what to block"
                                           Foreground="White" FontSize="12"
                                           FontFamily="{StaticResource InterLight}"/>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <!-- ══ SETTINGS VIEW ══ -->
                <Grid x:Name="AppearanceView" Visibility="Collapsed" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Settings" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

                    <!-- ── Alt Key Test row ── -->
                    <Border Grid.Row="1" Style="{StaticResource AppearanceCard}"
                            MouseLeftButtonDown="AltTestRow_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Test exit method" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Verify both Alt keys work on this machine" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" FontSize="14"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ── Appearance heading ── -->
                    <TextBlock Grid.Row="2" Text="Appearance" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="2,4,0,10"/>

                    <!-- Light -->
                    <Border Grid.Row="3" x:Name="ThemeLight" Style="{StaticResource AppearanceCard}"
                            MouseLeftButtonDown="ThemeLight_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="28" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#F3F3F3"/>
                                    <Rectangle Grid.Column="1" Fill="#FFFFFF"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Light" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="White &amp; light grey surfaces" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="LightCheck" Grid.Column="2" Text="✓"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Dark -->
                    <Border Grid.Row="4" x:Name="ThemeDark" Style="{StaticResource AppearanceCard}"
                            MouseLeftButtonDown="ThemeDark_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="28" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#202020"/>
                                    <Rectangle Grid.Column="1" Fill="#2C2C2C"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Dark" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Dark surfaces, easy on eyes" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DarkCheck" Grid.Column="2" Text="✓"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- System -->
                    <Border Grid.Row="5" x:Name="ThemeSystem" Style="{StaticResource AppearanceCard}"
                            MouseLeftButtonDown="ThemeSystem_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="28" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Fill="#F3F3F3"/>
                                    <Rectangle Grid.Column="1" Fill="#202020"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="System default" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Follows Windows appearance" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="SystemCheck" Grid.Column="2" Text="✓"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Back button -->
                    <Button Grid.Row="6" Content="← Back"
                            Height="38" Cursor="Hand"
                            Background="{DynamicResource RowBgBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            FontWeight="SemiBold" FontSize="13"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"
                            Click="BackBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ TEST VIEW — Alt Key Test (same frame, dark) ══ -->
                <Grid x:Name="TestView" Visibility="Collapsed"
                      Background="#0F0F0F">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center" Margin="24,0">

                        <TextBlock Text="TESTING EXIT METHOD"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="#444444" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <!-- Live timer -->
                        <TextBlock x:Name="TestTimerLabel" Text="00:00"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- Progress ring (96×96) -->
                        <Canvas Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Ellipse Canvas.Left="6" Canvas.Top="6"
                                     Width="84" Height="84"
                                     Stroke="#1E1E1E" StrokeThickness="5" Fill="Transparent"/>
                            <Path x:Name="TestRingPath" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent"/>
                        </Canvas>

                        <!-- Instruction -->
                        <TextBlock Text="Hold both Alt keys to finish"
                                   FontSize="12" Foreground="#777777"
                                   HorizontalAlignment="Center" Margin="0,0,0,14"/>

                        <!-- Key chips -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border Background="#1C1C1C" BorderBrush="#3D3D3D" BorderThickness="1"
                                    CornerRadius="5" Padding="10,5" Margin="0,0,4,0">
                                <TextBlock Text="L Alt" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="+" Foreground="#444" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Border Background="#1C1C1C" BorderBrush="#3D3D3D" BorderThickness="1"
                                    CornerRadius="5" Padding="10,5" Margin="0,0,6,0">
                                <TextBlock Text="R Alt" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="· 3s" Foreground="#444" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Status pill -->
                        <Border Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1"
                                CornerRadius="20" Padding="14,6" HorizontalAlignment="Center"
                                Margin="0,0,0,22">
                            <TextBlock Text="Nothing is blocked — this is only a test"
                                       Foreground="#555555" FontSize="11"/>
                        </Border>

                        <!-- Cancel -->
                        <Button Content="Cancel test" Height="36" Cursor="Hand"
                                Click="TestCancelBtn_Click"
                                Background="#1A1A1A" Foreground="#777777"
                                FontSize="12" BorderBrush="#2E2E2E" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="24,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- ══ ALT CHECK VIEW — first-run prompt (inline) ══ -->
                <Grid x:Name="AltCheckView" Visibility="Collapsed"
                      Background="{DynamicResource CardBrush}">
                    <StackPanel VerticalAlignment="Center" Margin="30,0">

                        <!-- Warning icon + title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Image x:Name="AltCheckWarningIcon"
                                   Width="22" Height="22"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Check your exit method"
                                       FontFamily="{StaticResource InterLight}"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,0,0,16"/>

                        <!-- Description -->
                        <TextBlock FontFamily="{StaticResource InterLight}"
                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6">
                            Cleanup Buddy uses
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource InterLight}"
                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,6">
                            both Alt keys held for 3 seconds
                        </TextBlock>
                        <TextBlock FontFamily="{StaticResource InterLight}"
                                   TextWrapping="Wrap" FontSize="12.5" LineHeight="21"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20">
                            to exit cleaning mode. Please verify both Alt keys work before using the app.
                        </TextBlock>

                        <!-- Never ask again checkbox -->
                        <CheckBox x:Name="NeverAskCheck" IsChecked="True"
                                  Cursor="Hand" Margin="0,0,0,26">
                            <CheckBox.Content>
                                <TextBlock Text="Don't ask again on this machine"
                                           FontFamily="{StaticResource InterLight}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"/>
                            </CheckBox.Content>
                        </CheckBox>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Skip for now -->
                            <Button Grid.Column="0" Height="40"
                                    Cursor="Hand" Click="AltCheckSkipBtn_Click"
                                    Background="{DynamicResource RowBgBrush}"
                                    Foreground="{DynamicResource MutedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="7">
                                            <TextBlock Text="Skip for now"
                                                       FontFamily="{StaticResource InterLight}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Test now -->
                            <Button Grid.Column="2" Height="40"
                                    Cursor="Hand" Click="AltCheckTestBtn_Click"
                                    Background="{DynamicResource AccentBrush}"
                                    BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                                            <TextBlock Text="Test now →"
                                                       FontFamily="{StaticResource InterLight}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
        </Border><!-- inner clip border -->
    </Border><!-- outer shadow border -->
</Window>